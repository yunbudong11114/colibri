# Install exactly one complete offline model. Never copy an entire build workspace.
function(colibri_install_offline_speech payload)
    set(ncnn_files tokens.txt encoder.ncnn.param encoder.ncnn.bin decoder.ncnn.param decoder.ncnn.bin joiner.ncnn.param joiner.ncnn.bin)
    if(EXISTS "${payload}/sherpa-ncnn")
        set(engine sherpa-ncnn)
        set(model_files ${ncnn_files})
    elseif(EXISTS "${payload}/sherpa-onnx")
        set(engine sherpa-onnx)
        set(model_files tokens.txt model.int8.onnx)
    else()
        message(FATAL_ERROR "No supported offline speech engine in ${payload}")
    endif()
    set(destination lib/${PROJECT_NAME}/offline-speech)
    install(PROGRAMS "${payload}/${engine}" DESTINATION "${destination}")
    foreach(name IN LISTS model_files)
        if(NOT EXISTS "${payload}/${name}")
            message(FATAL_ERROR "Offline speech payload missing ${name}")
        endif()
        install(FILES "${payload}/${name}" DESTINATION "${destination}")
    endforeach()
    if(IS_DIRECTORY "${payload}/lib")
        install(DIRECTORY "${payload}/lib/" DESTINATION "${destination}/lib"
                FILES_MATCHING PATTERN "*.so" PATTERN "*.so.*")
    endif()
    file(GLOB licenses "${payload}/LICENSE*" "${payload}/COPYING*" "${payload}/SOURCES*")
    if(licenses)
        install(FILES ${licenses} DESTINATION "${destination}")
    endif()
endfunction()
