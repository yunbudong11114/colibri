#!/bin/sh
set -eu
app_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -d "$app_dir/python" ]; then
    export PYTHONPATH="$app_dir/python"
    export COLIBRI_DEVICE_AUDIO=1
    exec /usr/bin/python3 "$app_dir/worker.py" "$@"
fi
exec "${COLIBRI_PYTHON:-$app_dir/../.venv/bin/python}" "$app_dir/worker.py" "$@"
